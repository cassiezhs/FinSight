DATABASE_URL=

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finsight
DB_SCHEMA=public
DB_SSLMODE=

# Required only for app AI summaries.
OPENAI_API_KEY=
OPENAI_ENABLED=0

# SEC asks for a descriptive user agent with contact information.
SEC_USER_AGENT=FinSight/0.1 contact@example.com
OPENAI_MODEL=gpt-4o-mini
# React dev server origin. Add hosted frontend origins if API and UI are split.
FINSIGHT_CORS_ORIGINS=http://localhost:5173

FINSIGHT_START_DATE=2018-01-01
# Use today to keep ingestion current, or set a fixed YYYY-MM-DD date.
FINSIGHT_END_DATE=today
FINSIGHT_DAILY_REFRESH_DAYS=10
# Daily refresh defaults to market prices only unless these are enabled.
FINSIGHT_DAILY_LOAD_8K=0
FINSIGHT_DAILY_LOAD_PERIODIC_SECTIONS=0
# Backward-compatible alias for FINSIGHT_DAILY_LOAD_PERIODIC_SECTIONS.
FINSIGHT_DAILY_LOAD_10K_SECTIONS=0
FINSIGHT_SEND_ALERTS=0
FINSIGHT_LOAD_8K_DETAILS=0
FINSIGHT_START_YEAR=2018
FINSIGHT_END_YEAR=2026
# Use a comma-separated list, or set to sp500 for the current S&P 500 universe.
FINSIGHT_TICKERS=sp500

# Set to 1 when you want the ingestion command to fetch SEC sections too.
FINSIGHT_LOAD_SEC=0

# Set to 1 to fetch 8-K filing metadata for chart event markers.
FINSIGHT_LOAD_8K=0
FINSIGHT_LOAD_8K_DETAILS=1

# Optional filing alert email delivery. Used by daily_refresh --send-alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
