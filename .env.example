DATABASE_URL=

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finsight
DB_SCHEMA=public
DB_SSLMODE=

# Required only for app AI summaries.
OPENAI_API_KEY=
OPENAI_ENABLED=0

# SEC asks for a descriptive user agent with contact information.
SEC_USER_AGENT=FinSight/0.1 contact@example.com
OPENAI_MODEL=gpt-4o-mini

FINSIGHT_START_DATE=2018-01-01
# Use today to keep ingestion current, or set a fixed YYYY-MM-DD date.
FINSIGHT_END_DATE=today
FINSIGHT_DAILY_REFRESH_DAYS=10
FINSIGHT_START_YEAR=2018
FINSIGHT_END_YEAR=2026
FINSIGHT_TICKERS=AAPL,MSFT,NVDA

# Set to 1 when you want the ingestion command to fetch SEC sections too.
FINSIGHT_LOAD_SEC=0

# Set to 1 to fetch 8-K filing metadata for chart event markers.
FINSIGHT_LOAD_8K=0
FINSIGHT_LOAD_8K_DETAILS=1
